# ============================================================
# 配置模板 —— 复制为 .env 后填写（.env 不入库，已在 .gitignore 中）
#
# 职责边界（重要，避免双源冲突）：
#   - 本文件只放「凭据 + 端点 + 运行参数」
#   - 业务默认值（如默认接入模式、指标口径、汇率规则）一律在
#     docs/20-domain/data-sources.md 与 docs/20-domain/metrics.md 中单源维护，
#     本文件不得重复定义，否则两边会各自过期。
# ============================================================


# ---------- 数据源：MySQL（默认接入模式） ----------
# 账号请只授予 SELECT 权限；harness 只做只读查询（规则 R-04）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
# 可选：仅作连接默认 schema。两个业务库名在 config/profile.yaml（facts_schema / dims_schema），不在本文件拆两套 MYSQL_DATABASE_*（ADR-056）
MYSQL_DATABASE=

# 库内已确认存在的表（语义与字段映射见 docs/20-domain/data-sources.md §1.2 / §5）：
#   exchange_rate              汇率表（N+1 规则）
#   shopify_sales_by_order     Shopify 订单级销售
#   产品型号度数范围            商品型号 → 度数/容量区间
#   nssku对应映射表             各电商 SKU → 内部 NSSKU
# TikTok 七张首阶段权威表由 profile 的 platform:tiktok 白名单声明（ADR-068）

# ---------- 数据源：本地文件导入（可选） ----------
# 当接入模式切到 file 时使用：Excel/CSV、汇率表、目标表都从这里读
LOCAL_DATA_DIR=./data/imports


# ============================================================
# LLM Provider（预留，未填写即 no-op，不静默降级 —— 守则 4 / ADR-006）
# 分层路由：强模型做编排/校验/报告；轻量模型做格式化与分片汇总
# 本地部署示例（Ollama / vLLM）：BASE_URL=http://localhost:11434/v1
# ============================================================

# ---------- 强模型：任务编排 / 结果校验 / 报告生成 ----------
LLM_STRONG_PROVIDER=          # openai | anthropic | deepseek | qwen | local
LLM_STRONG_BASE_URL=          # 留空则用该 provider 官方默认端点
LLM_STRONG_API_KEY=
LLM_STRONG_MODEL=             # 例：gpt-4o / claude-sonnet-4 / deepseek-chat / qwen-max

# ---------- 轻量模型：格式化 / 分片汇总（省 token，ADR-006） ----------
LLM_LIGHT_PROVIDER=
LLM_LIGHT_BASE_URL=
LLM_LIGHT_API_KEY=
LLM_LIGHT_MODEL=


# ---------- 能力开关（覆盖 config/profile.yaml 的同名默认值） ----------
# 未设置时一律以 profile.yaml 的默认值为准（默认 false = no-op，不静默降级 —— 守则 4）
HARNESS_ENABLE_REFUND_RECONCILIATION=false   # 退款实现率对账；需读 shopify_orders_mongo_refunds，开启后仅进对账区
HARNESS_ENABLE_PROMO_CALENDAR=false          # 大促日历；开启后须在 profile.yaml 提供 promo_calendar.events

# ---------- 运行参数（可选，均有默认，一般不用改） ----------
RUNS_DIR=./runs               # 证据包输出目录：每次任务一个子目录
MAX_QUERY_ROWS=500000         # 单次查询行数上限（规则 R-10）
QUERY_TIMEOUT_SEC=120         # 单次查询超时（秒）
TOKEN_BUDGET_PER_RUN=         # 留空则不启用预算告警（规则 R-11）

# ---------- 预留能力开关（ADR-066；默认 false = 显式 no-op，禁止静默降级） ----------
HARNESS_ENABLE_MCP=false
HARNESS_ENABLE_WEB=false
HARNESS_ENABLE_SCHEDULE=false
HARNESS_ENABLE_SESSION_MEMORY=false
HARNESS_ENABLE_VECTOR_MEMORY=false
HARNESS_ENABLE_OTEL=false
HARNESS_ENABLE_PII_ACCESS=false          # 默认 deny；开启仍需任务级独立授权与留痕（R-92）
